# ============================================================================
# sybsec environment — copy to .env and change EVERY secret before deploying.
# Nothing in this stack should ship with these defaults in production.
# ============================================================================

# --- Global ---
COMPOSE_PROJECT_NAME=sybsec
STACK_VERSION=8.15.0
CLUSTER_NAME=sybsec-soc
TZ=UTC

# --- Elasticsearch / Kibana ---
ELASTIC_PASSWORD=changeme_elastic
KIBANA_PASSWORD=changeme_kibana
ES_PORT=9200
ES_JAVA_OPTS="-Xms2g -Xmx2g"
KIBANA_PORT=5601

# --- Kafka (KRaft, single broker dev) ---
KAFKA_BROKER=kafka:9092
KAFKA_EXTERNAL_PORT=29092
KAFKA_CLUSTER_ID=sybsec-kraft-cluster-0001

# --- Wazuh ---
WAZUH_VERSION=4.9.0
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=changeme_wazuh_api
WAZUH_INDEXER_PASSWORD=changeme_indexer

# --- ML anomaly service ---
ML_PORT=8088
ML_LOG_LEVEL=INFO
ML_ES_INDEX=security-anomalies
ML_ANOMALY_THRESHOLD=0.85
ML_KAFKA_TOPICS=zeek-logs,suricata-alerts,wazuh-events,sysmon-events
ML_KAFKA_GROUP=ml-anomaly
ML_MODEL_DIR=/app/models/artifacts
ML_RETRAIN_CRON="0 3 * * 0"

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana

# --- Threat intel / case mgmt / SOAR (used in later iterations) ---
MISP_ADMIN_EMAIL=admin@sybsec.local
MISP_ADMIN_PASSWORD=changeme_misp
THEHIVE_SECRET=changeme_thehive_secret
CORTEX_API_KEY=changeme_cortex_key
SHUFFLE_DEFAULT_APIKEY=changeme_shuffle_key

# --- External analyzer API keys (Cortex / SOAR). Leave blank to disable. ---
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
URLSCAN_API_KEY=
MISP_API_KEY=
OPENCTI_TOKEN=
