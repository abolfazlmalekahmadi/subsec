# Shuffle deploy env (copy to .env). Defaults below are DEMO values — change them.
# Full template comes from the upstream Shuffle repo; these are the keys that matter.
SHUFFLE_DEFAULT_USERNAME=admin@sybsec.local
SHUFFLE_DEFAULT_PASSWORD=sybsec-shuffle-admin
SHUFFLE_DEFAULT_APIKEY=sybsec-shuffle-apikey-0001

FRONTEND_PORT=3001
FRONTEND_PORT_HTTPS=3443
BACKEND_PORT=5001
BACKEND_HOSTNAME=shuffle-backend
OUTER_HOSTNAME=shuffle-backend
BASE_URL=http://shuffle-backend:5001
SSO_REDIRECT_URL=http://localhost:3001

# OpenSearch (Shuffle's DB). Host port remapped 9200->9205 to avoid clashing
# with the core Elasticsearch. Heap trimmed to 1g for single-host dev.
DB_LOCATION=./shuffle-database
SHUFFLE_APP_HOTLOAD_FOLDER=./shuffle-apps
SHUFFLE_FILE_LOCATION=./shuffle-files
DOCKER_API_VERSION=1.44
