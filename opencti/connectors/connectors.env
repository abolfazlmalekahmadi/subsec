# OpenCTI connector configuration (env for docker-compose.connectors.yml).
# Secrets are injected from the root .env at deploy time — never commit real keys.

# --- OpenCTI core ---
OPENCTI_URL=http://opencti:8080
OPENCTI_TOKEN=${OPENCTI_TOKEN}

# --- MITRE ATT&CK connector (imports the ATT&CK matrix) ---
CONNECTOR_MITRE_ID=mitre--$(uuidgen)
CONNECTOR_MITRE_TYPE=EXTERNAL_IMPORT
CONNECTOR_MITRE_NAME=MITRE ATT&CK
CONNECTOR_MITRE_SCOPE=tool,report,malware,identity,attack-pattern,course-of-action,intrusion-set,campaign,x-mitre-data-source
CONNECTOR_MITRE_INTERVAL=7        # days
MITRE_ENTERPRISE_FILE_URL=https://raw.githubusercontent.com/mitre/cti/master/enterprise-attack/enterprise-attack.json

# --- MISP connector (ingest IoCs from MISP into OpenCTI) ---
CONNECTOR_MISP_ID=misp--$(uuidgen)
CONNECTOR_MISP_TYPE=EXTERNAL_IMPORT
CONNECTOR_MISP_NAME=MISP
CONNECTOR_MISP_SCOPE=misp
MISP_URL=https://misp
MISP_KEY=${MISP_API_KEY}
MISP_SSL_VERIFY=false
MISP_IMPORT_FROM_DATE=2026-01-01
MISP_CREATE_REPORTS=true
MISP_REPORT_TYPE=misp-event
MISP_INTERVAL=5                   # minutes
