# sybsec custom Suricata rules. SIDs in the 9,000,000+ local range.
# Run `suricata-update` (see sigma/ and scripts) to add the Emerging Threats set.

# --- Data exfiltration: large outbound flow to external net (Playbook 4) ---
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"SYBSEC Large outbound transfer (>500MB) possible exfiltration"; flow:established,to_server; flowbits:isset,sybsec.bigflow; threshold:type both, track by_src, count 1, seconds 600; classtype:policy-violation; sid:9000001; rev:1;)

# --- Suspicious DNS: long TXT / DGA-like (covert channel) ---
alert dns $HOME_NET any -> any any (msg:"SYBSEC Suspicious long DNS query - possible DGA/tunnel"; dns.query; content:!"."; pcre:"/^[a-z0-9]{30,}\./i"; classtype:bad-unknown; sid:9000002; rev:1;)

# --- Known C2 user-agent (example placeholder; replace with curated IoCs) ---
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"SYBSEC Suspicious empty/short User-Agent on outbound HTTP"; flow:established,to_server; http.user_agent; content:"-"; depth:1; classtype:trojan-activity; sid:9000003; rev:1;)

# --- Reverse shell indicator: outbound to common RAT ports ---
alert tcp $HOME_NET any -> $EXTERNAL_NET [4444,5555,1337,31337] (msg:"SYBSEC Outbound to common reverse-shell port"; flow:to_server; classtype:trojan-activity; sid:9000004; rev:1;)
