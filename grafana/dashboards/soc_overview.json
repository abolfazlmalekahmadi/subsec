  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total alerts (24h)",
      "datasource": {
        "type": "elasticsearch",
        "uid": "sybsec-es"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "sybsec-es"
          },
          "query": "event.kind:alert",
          "alias": "",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "5m",
                "min_doc_count": "0"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ]
    },
