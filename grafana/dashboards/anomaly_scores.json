{
  "uid": "sybsec-anomaly-scores",
  "title": "sybsec \u2014 ML Anomaly Scores",
  "tags": [
    "sybsec",
    "ml"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Mean anomaly score",
      "datasource": {
        "type": "elasticsearch",
        "uid": "sybsec-es"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "auto"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "sybsec-es"
          },
          "query": "event.module:\"ml-anomaly\"",
          "alias": "",
          "metrics": [
            {
              "id": "1",
              "type": "avg",
              "field": "anomaly_score"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "1h",
                "min_doc_count": "0"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Anomaly count over time",
      "datasource": {
        "type": "elasticsearch",
        "uid": "sybsec-es"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "auto"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "sybsec-es"
          },
          "query": "is_anomaly:true",
          "alias": "",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "1h",
                "min_doc_count": "0"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ]
    }
  ]
}